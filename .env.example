# Web runtime database/object-store bindings are provisioned by Sites from .openai/hosting.json.
# Native build configuration (no credentials):
APP_ORIGIN=https://your-production-origin.example

# Standalone Cloudflare Workers Builds (set actual values in Cloudflare):
CLOUDFLARE_D1_DATABASE_ID=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
BOOTSTRAP_ADMIN_EMAIL=
